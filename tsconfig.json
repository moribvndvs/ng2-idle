{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "esModuleInterop": true,
    "sourceMap": true,
    "declaration": false,
    "module": "es2020",
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "typeRoots": [
      "node_modules/@types"
    ],
    "paths": {
      "@ng-idle/core": [
        "./dist/core"
      ],
      "@ng-idle/core/*": [
        "./dist/core/*"
      ],
      "@ng-idle/keepalive": [
        "./dist/keepalive"
      ],
      "@ng-idle/keepalive/*": [
        "./dist/keepalive/*"
      ]
    },
    "useDefineForClassFields": false,
    "strict": false
  }
}
